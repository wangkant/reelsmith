{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "lib",
    "rootDir": "src",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["src/*.ts"],
  "exclude": ["src/client.tsx"]
}
